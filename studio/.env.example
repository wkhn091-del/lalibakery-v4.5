# העתיקו ל-studio/.env ומלאו. לא סודות (מזהה הפרויקט גלוי בכל כתובת תמונה), אבל לא ב-git.
# ההסבר המלא: ../CMS.md

# sanity.io/manage > הפרויקט > "Project ID". אותו ערך כמו NEXT_PUBLIC_SANITY_PROJECT_ID באתר
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# רק השם של ה-Studio המאורח, בלי https:// ובלי .sanity.studio: אותיות אנגליות קטנות, ספרות ומקפים.
# למשל lalibakery, וה-Studio יהיה ב-https://lalibakery.sanity.studio. זו לא כתובת האתר.
SANITY_STUDIO_HOSTNAME=

# שפות נוספות לשדות החנות, מעבר לעברית: en, ru או en,ru. ריק = עברית בלבד (ההשקה).
# מפעילים יחד עם NEXT_PUBLIC_LOCALES באתר.
SANITY_STUDIO_EXTRA_LOCALES=

# כתובת האתר ש"עריכה על האתר" מציגה היא הגדרה אחרת: SANITY_STUDIO_PREVIEW_URL. בפיתוח לא צריך אותה,
# ול-Studio המאורח כותבים אותה ב-studio/.env.production (התבנית: .env.production.example).
