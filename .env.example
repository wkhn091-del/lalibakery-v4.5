# העתיקו ל-.env.local (בפיתוח) והגדירו את אותם ערכים ב-Vercel: Settings > Environment Variables.
# ההסבר המלא: CMS.md

# הכתובת האמיתית של האתר (לתמונת השיתוף, ל-sitemap ולנתונים לגוגל)
NEXT_PUBLIC_SITE_URL=https://www.example.co.il

# ── Sanity (ה-CMS) ──
# מזהה הפרויקט: sanity.io/manage > הפרויקט > למעלה, "Project ID". לא סוד (מופיע בכל כתובת תמונה).
# ריק = האתר מציג את התוכן המובנה שלו, בדיוק כמו לפני החיבור ל-CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# סוד: מחרוזת אקראית ארוכה (למשל: openssl rand -hex 32), אותה מחרוזת בדיוק ב-webhook של Sanity.
# בלעדיה, שינויים ב-CMS יופיעו באתר רק אחרי עד שעה.
SANITY_REVALIDATE_SECRET=

# סוד: טוקן עם הרשאת Viewer בלבד (sanity.io/manage > הפרויקט > API > Tokens). נדרש ל"עריכה על
# האתר" ב-Studio (קריאת טיוטות), ול-dataset פרטי. נשאר בשרת ואף פעם לא מגיע לדפדפן. בלעדיו האתר
# עובד כרגיל, רק "עריכה על האתר" לא נפתחת. באתר אין ולא צריך להיות טוקן עם הרשאת כתיבה.
SANITY_API_READ_TOKEN=

# כתובת ה-Studio (לא סוד), למשל https://lalibakery.sanity.studio: לחיצה על טקסט בתצוגה מקדימה
# שנפתחה מחוץ ל-Studio פותחת את השדה שם. ריק = http://localhost:3333 (פיתוח)
NEXT_PUBLIC_SANITY_STUDIO_URL=

# שפות האתר (לא סוד): he תמיד, ואפשר להוסיף en ו-ru כשהטקסטים מוכנים, למשל he,en,ru.
# ריק = עברית בלבד. מפעילים יחד עם SANITY_STUDIO_EXTRA_LOCALES ב-Studio.
NEXT_PUBLIC_LOCALES=

# רק ל-dataset פרטי (Private, בתוכנית בתשלום): true = גם התוכן שפורסם נקרא עם הטוקן. ציבורי: ריק
SANITY_PRIVATE_DATASET=

# ════════════════ גרסה 6: ניטור, כניסה בטלפון ותזכורות. ההסבר המלא: SERVICES.md ════════════════
# כל עוד משתנה ריק, החלק שלו כבוי והאתר עובד כמו קודם.

# ── Sentry (ניטור שגיאות) ──
NEXT_PUBLIC_SENTRY_DSN=
# ל-source maps בזמן build בלבד (הטוקן סודי)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
# סוד, שרת בלבד (sb_secret_…): עוקף הרשאות, משמש רק את התזכורות
SUPABASE_SECRET_KEY=
# הסוד של ה-Send SMS hook, כפי שמופיע ב-Supabase (v1,whsec_…)
SEND_SMS_HOOK_SECRET=

# ── Upstash ──
# Redis, למגבלות (דרך ה-Marketplace של Vercel: KV_REST_API_URL ו-KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# מחרוזת אקראית: openssl rand -hex 32
RATE_LIMIT_SALT=
# QStash, לתזכורות
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Twilio (SMS). בפיתוח, בלי אלה, ההודעות מודפסות בטרמינל ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# או, במקום Messaging Service, שולח ישיר: TWILIO_FROM=

# ════════════════ החנות: הזמנות, תשלום והתראות. ההסבר המלא: DEPLOY.md ════════════════
# משתנה שהוגדר בפורמט לא תקין עוצר את השרת בעלייה, עם שם המשתנה (בלי הערך). משתנה ריק = החלק כבוי.

# סוד, שרת בלבד: מפתח ה-service role של Supabase (אם אין SUPABASE_SECRET_KEY). אסור NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# סוד: "פלפל" לקודי הקופונים (נשמרים כ-HMAC, לא כטקסט). לפחות 32 תווים: openssl rand -hex 32
# אחרי שנוצרו קופונים אסור לשנות, אחרת הקודים הקיימים יפסיקו לעבוד.
COUPON_PEPPER=
# סוד: חתימת הקישור להזמנת אורח (/order/...), תקף 72 שעות. לפחות 32 תווים.
ORDER_LINK_SECRET=

# ── Grow (משולם): עמוד התשלום. ריק = הקופה מציעה רק תשלום בוואטסאפ, בטלפון או במקום ──
# ריק = sandbox בפיתוח, ו-https://secure.meshulam.co.il בייצור
GROW_API_URL=
GROW_PAGE_CODE=
GROW_USER_ID=
# סוד
GROW_API_KEY=

# ── Cloudflare Turnstile (בדיקת "לא רובוט" בקופה ובבונה העוגות) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# סוד
TURNSTILE_SECRET_KEY=

# ── Resend (מיילים על הזמנות) ──
# סוד (re_…)
RESEND_API_KEY=
# למשל: Lalibakery <orders@lalibakery.co.il> (הדומיין מאומת ב-Resend)
ORDERS_EMAIL_FROM=
# לאן מגיע העותק של בעלת העסק
ORDERS_EMAIL_TO=

# ── Google Sheets (יומן הזמנות: קוד, תאריך, עיר, סכום, סטטוס בלבד) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# סוד: ה-private_key מקובץ ה-JSON של חשבון השירות, כולל השורות BEGIN/END (\n במקום ירידת שורה)
GOOGLE_SERVICE_ACCOUNT_KEY=
# המזהה מכתובת הגיליון (בין /d/ ל-/edit). משתפים את הגיליון עם המייל של חשבון השירות, כעורך.
ORDERS_SHEET_ID=

# סוד: Vercel Cron שולח אותו לעבודות (ביטול הזמנות שלא שולמו, מחיקת כתובות אחרי 24 חודשים)
CRON_SECRET=

# ── Meta Pixel (לא סוד; נטען רק אחרי הסכמה בבאנר העוגיות) ──
NEXT_PUBLIC_META_PIXEL_ID=
